## **Simplified Example: Creating a "Inventory" Module**

Here's a step-by-step example for a new engineer to create an Inventory module:

### **Step 1: Generate Module**
```bash
php artisan module:make Inventory
```

### **Step 2: Create Basic Entity**
```php:Modules/Inventory/Entities/InventoryItem.php
<?php

namespace Modules\Inventory\Entities;

use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Modules\Product\Entities\Product;

class InventoryItem extends Model
{
    use HasFactory;

    protected $guarded = [];

    // Relationship to Product module
    public function product() {
        return $this->belongsTo(Product::class);
    }

    // Price formatting (follows app pattern)
    public function setQuantityAttribute($value) {
        $this->attributes['quantity'] = $value;
    }
}
```

### **Step 3: Create Migration**
```php:Modules/Inventory/Database/Migrations/2024_01_01_000000_create_inventory_items_table.php
<?php

use Illuminate\Database\Migrations\Migration;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\Schema;

class CreateInventoryItemsTable extends Migration
{
    public function up()
    {
        Schema::create('inventory_items', function (Blueprint $table) {
            $table->id();
            $table->unsignedBigInteger('product_id');
            $table->integer('quantity');
            $table->string('location')->nullable();
            $table->foreign('product_id')->references('id')->on('products')->cascadeOnDelete();
            $table->timestamps();
        });
    }

    public function down()
    {
        Schema::dropIfExists('inventory_items');
    }
}
```

### **Step 4: Create Controller**
```php:Modules/Inventory/Http/Controllers/InventoryController.php
<?php

namespace Modules\Inventory\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Routing\Controller;
use Illuminate\Support\Facades\Gate;
use Modules\Inventory\DataTables\InventoryDataTable;
use Modules\Inventory\Entities\InventoryItem;

class InventoryController extends Controller
{
    public function index(InventoryDataTable $dataTable) {
        abort_if(Gate::denies('access_inventory'), 403);
        return $dataTable->render('inventory::index');
    }

    public function store(Request $request) {
        abort_if(Gate::denies('create_inventory'), 403);
        
        InventoryItem::create($request->validated());
        
        toast('Inventory Item Created!', 'success');
        return redirect()->route('inventory.index');
    }

    // ... other CRUD methods following same pattern
}
```

### **Step 5: Create DataTable**
```php:Modules/Inventory/DataTables/InventoryDataTable.php
<?php

namespace Modules\Inventory\DataTables;

use Modules\Inventory\Entities\InventoryItem;
use Yajra\DataTables\Services\DataTable;

class InventoryDataTable extends DataTable
{
    public function dataTable($query)
    {
        return datatables()
            ->eloquent($query)
            ->addColumn('action', function ($data) {
                return view('inventory::partials.actions', compact('data'));
            })
            ->addColumn('product_name', function ($data) {
                return $data->product->product_name;
            });
    }

    public function query(InventoryItem $model)
    {
        return $model->newQuery()->with('product');
    }

    // ... rest of DataTable configuration
}
```

### **Step 6: Create Livewire Component**
```php:app/Livewire/Inventory/InventorySearch.php
<?php

namespace App\Livewire\Inventory;

use Livewire\Component;
use Modules\Inventory\Entities\InventoryItem;

class InventorySearch extends Component
{
    public $search = '';
    public $results;

    protected $listeners = ['refreshInventory' => '$refresh'];

    public function mount() {
        $this->results = collect();
    }

    public function render() {
        return view('livewire.inventory.inventory-search');
    }

    public function updatedSearch() {
        $this->results = InventoryItem::with('product')
            ->whereHas('product', function($query) {
                $query->where('product_name', 'like', '%' . $this->search . '%');
            })
            ->take(10)
            ->get();
    }

    public function selectItem($itemId) {
        $item = InventoryItem::find($itemId);
        $this->dispatch('inventoryItemSelected', $item);
    }
}
```

### **Step 7: Add Routes**
```php:Modules/Inventory/Routes/web.php
<?php

Route::group(['middleware' => 'auth'], function () {
    Route::resource('inventory', 'InventoryController');
    Route::get('inventory/search', 'InventoryController@search')->name('inventory.search');
});
```

